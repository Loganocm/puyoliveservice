# Consistent whitespace for every editor and agent. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ts,tsx,js,mjs}]
# Existing code uses both 2 and 4 spaces by file: keep a file's own style.
indent_size = unset

[*.md]
trim_trailing_whitespace = false
