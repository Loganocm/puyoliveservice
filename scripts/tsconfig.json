{
  // Node scripts (docs-check and friends). Type-checked in CI with
  // `npx tsc -p scripts`; run with tsx.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["**/*.ts"]
}
