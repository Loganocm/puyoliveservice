{
  "name": "@puyolive/engine",
  "version": "1.0.0",
  "private": true,
  "description": "The Puyo simulation. Shared by the browser client and the game server.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
